{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "paths": {
      "#classes/*": ["./app/classes/*.js"],
      "#album/*": ["./app/album/*.js"],
      "#artist/*": ["./app/artist/*.js"],
      "#track/*": ["./app/track/*.js"],
      "#auth/*": ["./app/auth/*.js"],
      "#profile/*": ["./app/profile/*.js"],
      "#spotify/*": ["./app/spotify/*.js"],
      "#favorite/*": ["./app/favorite/*.js"],
      "#controllers/*": ["./app/controllers/*.js"],
      "#exceptions/*": ["./app/exceptions/*.js"],
      "#models/*": ["./app/auth/models/*.js"],
      "#services/*": ["./services/*.ts"],
      "#listeners/*": ["./app/listeners/*.js"],
      "#events/*": ["./app/events/*.js"],
      "#middleware/*": ["./app/middleware/*.js"],
      "#validators/*": ["./app/auth/validators/*.js"],
      "#start/*": ["./start/*.js"],
      "#config/*": ["./config/*.js"]

    }
  }
}
